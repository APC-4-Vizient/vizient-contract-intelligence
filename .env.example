DATAVERSE_URL=
TENANT_ID=
MCP_CLIENT_ID=aebc6443-996d-45c2-90f0-388ff96faa56
DATAVERSE_PLUGIN_VERSION=1.16.1
DATAVERSE_PLUGIN_AGENT=copilot
SOLUTION_NAME=VizientContractPOC
PUBLISHER_NAME=VizientContractIntelligence
PUBLISHER_PREFIX=vz
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus2
PA_CLI_ENVIRONMENT_ID=
CONTRACT_DATA_MODE=synthetic

# Only in an environment shared with other work: objects that the same account made for that work sit outside this
# solution on purpose. List them as TYPE:ID pairs (for example 300:<app id>) and verify-solution.py skips them, aloud.
SOLUTION_GUARD_IGNORE=

# Exact Azure account the CLI must be signed in as (the admin account, never a corporate one).
AZURE_ACCOUNT=

# Cloud flows (scripts/provision-flow.py). The SharePoint site and library hold the contract intake folder.
# The connection names are the names of existing, connected SharePoint and Dataverse connections that the
# signed-in admin owns; list them with `pa connection list`. The Function address and key are never kept here.
SHAREPOINT_SITE_URL=
SHAREPOINT_LIBRARY_ID=
SHAREPOINT_INTAKE_FOLDER=/Shared Documents/Contract Intake
SHAREPOINT_CONNECTION_NAME=
DATAVERSE_CONNECTION_NAME=

# Content Understanding. CU_ENDPOINT exists once the Foundry resource is deployed.
# The deployment names default to the model names, so leave them blank unless they differ.
CU_ENDPOINT=
CU_COMPLETION_MODEL=gpt-5.5
CU_COMPLETION_DEPLOYMENT=
CU_EMBEDDING_MODEL=text-embedding-3-large
CU_EMBEDDING_DEPLOYMENT=

